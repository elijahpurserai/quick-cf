{
  // Cloudflare Worker config for Quick — single-origin (SPA + Express API on one Worker).
  // Frontend build (website/dist) is served by Static Assets; the Express app runs on the
  // same Worker via the Node-compat httpServerHandler shim (see server/worker.ts).
  "name": "quick-cf",
  "main": "server/worker.ts",

  // Running Express (app.listen → http.createServer) via httpServerHandler needs the Node
  // HTTP server modules (the enable_nodejs_http_server_modules flag, auto-on at date >=
  // 2025-09-01 with nodejs_compat; listed explicitly for clarity).
  //
  // The date is kept recent (2026-07-24) on purpose: an earlier fix in workerd (cloudflare/
  // workerd#5084) makes express.json() populate req.body on POSTs under httpServerHandler,
  // and that behavior is gated behind the compatibility date. At 2025-09-01 req.body was
  // undefined and POST handlers 500'd. Do not lower this below the #5084 fix.
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],

  // Custom build — runs on every `wrangler deploy` (and in Cloudflare Workers Builds CI),
  // BEFORE bundling/asset validation. Installs the website + server deps and builds
  // website/dist. Cloudflare Workers Builds auto-installs the ROOT deps first, but not the
  // per-package ones, so we install them here. The frontend's public VITE_* build vars come
  // from website/.env.production (committed). No dashboard build config needed.
  "build": {
    "command": "cd website && npm install && npm run build && cd ../server && npm install"
  },

  "assets": {
    "directory": "./website/dist",
    "binding": "ASSETS",
    // Serve /index.html for unmatched client-side routes (React Router).
    "not_found_handling": "single-page-application",
    // Hand these paths to the Worker (Express) BEFORE static assets:
    //  - /api/*                    → API routes
    //  - SEO files                 → sitemap.ts / robots.txt
    //  - story/lesson HTML         → seoPrerender (bots) / SPA (browsers)
    //  - all-stories/all-lessons,  → seoPrerender directory + category prerender for bots.
    //    /cat, /tag directory        Browsers still fall through to the clean SPA.
    // Everything else (hashed JS/CSS, images, favicon) is served free from Static Assets.
    "run_worker_first": [
      "/api/*",
      "/robots.txt",
      "/sitemap.xml",
      "/sitemap-*.xml",
      // /health carries the X-Robots-Tag middleware; without it Static Assets answers
      // and the header is never set.
      "/health",
      // Both shapes are required: "/*/story/*" needs a leading path segment and does
      // NOT match an un-prefixed "/story/:slug".
      "/story/*",
      "/lesson/*",
      "/*/story/*",
      "/*/lesson/*",
      "/all-stories",
      "/all-lessons",
      "/*/all-stories",
      "/*/all-lessons",
      "/sitemap/all-stories",
      "/sitemap/all-lessons",
      "/*/sitemap/all-stories",
      "/*/sitemap/all-lessons",
      "/cat/*",
      "/*/cat/*",
      "/tag/*",
      "/*/tag/*"
    ]
  },

  // Non-secret vars. Secrets (OPENAI_API_KEY, SUPABASE_SERVICE_ROLE_KEY, JWT_SECRET,
  // GOOGLE_CLIENT_ID) are set with `wrangler secret put <NAME>` — never commit them.
  "vars": {
    "NODE_ENV": "production",
    "CLIENT_URL": "https://quickstory.ai",
    // Public (also baked into the frontend bundle). The Worker's server code reads
    // process.env.VITE_SUPABASE_URL for the service-role Supabase client.
    "VITE_SUPABASE_URL": "https://cjowsngbmaolaugvtyxm.supabase.co",
    // Origin the in-app test suite (server/tests/*) targets. On the Worker there is no
    // localhost, so the tests hit this public URL (self-request) instead. Update this to
    // https://quickstory.ai when you cut the production domain over. Locally it's unset,
    // so the suite falls back to http://localhost:3001 (the dev server).
    "TEST_BASE_URL": "https://quick-cf.imaginationai.workers.dev"
  },

  "observability": { "enabled": true }
}
